#!/bin/sh

# Start a separate Chrome process that inherits the private IBus session.
set -u

app_name="GrokBot! I'M JAPANESE!!"
runtime=${GROKBOT_IME_RUNTIME:-$HOME/.local/libexec/grokbot-ime/runtime}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
env_file=${GROKBOT_IME_SESSION_ENV:-$cache_home/grokbot-ime/session.env}

show_error() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical -a "$app_name" 'Chrome could not be started' "$1" \
            >/dev/null 2>&1 || true
    fi
    printf 'ERROR: %s\n' "$1" >&2
}

if [ ! -x "$runtime" ]; then
    show_error "IME runtime is missing: $runtime"
    exit 1
fi
if ! "$runtime" ensure; then
    exit 1
fi
if [ ! -r "$env_file" ]; then
    show_error "IME session file is missing: $env_file"
    exit 1
fi

. "$env_file"
export DBUS_SESSION_BUS_ADDRESS IBUS_ADDRESS
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus

if [ -n "${GROKBOT_IME_BROWSER:-}" ]; then
    browser=$GROKBOT_IME_BROWSER
elif [ -x /opt/google/chrome/chrome ]; then
    browser=/opt/google/chrome/chrome
elif command -v google-chrome-stable >/dev/null 2>&1; then
    browser=$(command -v google-chrome-stable)
elif command -v chromium >/dev/null 2>&1; then
    browser=$(command -v chromium)
elif command -v chromium-browser >/dev/null 2>&1; then
    browser=$(command -v chromium-browser)
else
    show_error 'Chrome/Chromium executable was not found.'
    exit 127
fi

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
profile_dir=${GROKBOT_IME_CHROME_PROFILE:-$data_home/grokbot-ime/chrome-profile}
mkdir -p "$profile_dir" || exit 1

if [ "$#" -eq 0 ]; then
    set -- http://127.0.0.1:8080
fi

exec "$browser" \
    --user-data-dir="$profile_dir" \
    --class=grokbot-ime-chrome \
    --no-sandbox \
    --disable-dev-shm-usage \
    --password-store=basic \
    --no-first-run \
    --no-default-browser-check \
    --gtk-version=3 \
    --ozone-platform=x11 \
    --new-window "$@"
