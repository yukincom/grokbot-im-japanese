#!/bin/sh

# Toggle the current IBus engine between US English and Mozc Hiragana.
set -u

english_engine=${IBUS_TOGGLE_ENGLISH_ENGINE:-xkb:us::eng}
runtime=${GROKBOT_IME_RUNTIME:-$HOME/.local/libexec/grokbot-ime/runtime}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
env_file=${GROKBOT_IME_SESSION_ENV:-$cache_home/grokbot-ime/session.env}

show_error() {
    message=$1
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical -a "GrokBot! I'M JAPANESE!!" \
            'Input method could not be changed' "$message"
    fi
    printf '%s\n' "$message" >&2
}

show_mode() {
    message=$1
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 1200 -a "GrokBot! I'M JAPANESE!!" \
            'Input method' "$message"
    fi
}

if [ -x "$runtime" ]; then
    "$runtime" ensure || exit 1
fi

if [ -r "$env_file" ]; then
    . "$env_file"
    export DBUS_SESSION_BUS_ADDRESS IBUS_ADDRESS
fi

if ! command -v ibus >/dev/null 2>&1; then
    show_error 'The ibus command was not found and automatic repair was unavailable.'
    exit 127
fi

japanese_engine=${IBUS_TOGGLE_JAPANESE_ENGINE:-${GROKBOT_JAPANESE_ENGINE:-mozc-on}}

if ! current_engine=$(ibus engine 2>/dev/null); then
    show_error 'IBus is not running in this desktop session.'
    exit 1
fi

case $current_engine in
    "$english_engine")
        target_engine=$japanese_engine
        mode_label='日本語入力 (Mozc・ひらがな)'
        ;;
    *)
        target_engine=$english_engine
        mode_label='英字入力 (US)'
        ;;
esac

error_message=$(ibus engine "$target_engine" 2>&1)
switch_status=$?
confirmed_engine=$(ibus engine 2>/dev/null || true)

# Some IBus/Mozc builds return a failure status after the engine has already
# changed. Treat the observed engine as authoritative.
if [ "$confirmed_engine" != "$target_engine" ]; then
    if [ -n "$error_message" ]; then
        show_error "Failed to switch to $target_engine: $error_message"
    else
        show_error "Failed to switch to $target_engine (status $switch_status)."
    fi
    exit 1
fi

show_mode "$mode_label"
exit 0
